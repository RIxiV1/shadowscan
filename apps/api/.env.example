# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --------------------------------------------------------------- database ---
# Local:  mongodb://127.0.0.1:27017/shadowscan
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/shadowscan?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shadowscan

# ------------------------------------------------------------------- auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The server refuses to boot with a weak secret.
JWT_SECRET=change-me-to-a-48-byte-random-string-before-deploying
JWT_EXPIRES_IN=8h

# One-time token that authorises creation of the very first admin account.
# After that account exists, /api/auth/register rejects every request that is not
# made by an authenticated admin. Rotate or unset this once you have your account.
BOOTSTRAP_TOKEN=change-me-too

# ------------------------------------------------------------------- cors ---
# Comma-separated list of exact origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- ingestion ---
# Hard ceiling on a single upload, in bytes. Default 10 MiB.
MAX_UPLOAD_BYTES=10485760
# Rows accepted from one file. Protects the event loop from a 500k-line paste.
MAX_ROWS_PER_UPLOAD=50000

# ------------------------------------------------------------------ seeds ---
# Used by `npm run seed` to create the demo admin. Never set these in production.
SEED_ADMIN_EMAIL=admin@shadowscan.local
SEED_ADMIN_PASSWORD=ShadowScan!2026
SEED_ADMIN_NAME=Security Admin
