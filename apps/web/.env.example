# Base URL of the ShadowScan API.
#
# Leave unset in development: Vite proxies /api to http://localhost:4000, which
# keeps the browser on one origin and exercises the same path as production.
#
# In production set this to the deployed API origin *including* /api, e.g.
#   VITE_API_URL=https://shadowscan-api.onrender.com/api
VITE_API_URL=
